# =============================================================
# GlobeHub AI — 環境変数テンプレート
# このファイルをコピーして .env を作成し、各キーを入力してください
# cp .env.example .env
# =============================================================

# ── データベース ──────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Claude API（Anthropic）── STEP 1 で取得 ─────────────────
# 取得先: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Tavily（Web検索 for 旅行計画機能）── STEP 1 で取得 ──────
# 取得先: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Pexels（スポット写真 — 無料 25,000リクエスト/月）─────────
# 取得先: https://www.pexels.com/api/ （無料・即取得可）
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI（Whisper 音声→テキスト変換）── STEP 3 で使用 ─────
# 取得先: https://platform.openai.com
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI モデル設定 ─────────────────────────────────────────────
# Claude モデル選択
CLAUDE_MODEL=claude-sonnet-4-6

# テキスト整形・旅行計画の最大出力トークン数
CLAUDE_MAX_OUTPUT_TOKENS=1500

# チャット機能の温度パラメータ（0.0〜1.0）
CLAUDE_TEMPERATURE=0.7

# ── 既存 OpenAI チャット設定（移行前の互換用）─────────────────
OPENAI_MODEL=gpt-4o-mini
MAX_OUTPUT_TOKENS=220
TEMPERATURE=0.6
MAX_REQ_TOKENS=1200

# ── コスト管理 ────────────────────────────────────────────────
# ユーザーあたりの月間API上限（USD）
API_BUDGET_USD_MONTH=5

# ── 機能フラグ ────────────────────────────────────────────────
# 音声入力を有効にするか（STEP 3 完了後に true に変更）
ENABLE_STT=false

# AI 旅行計画機能を有効にするか（STEP 5 完了後に true に変更）
ENABLE_TRIP_PLANNER=false

# AI 自動整形機能を有効にするか（STEP 4 完了後に true に変更）
ENABLE_AI_FORMAT=false

# ── セッション ────────────────────────────────────────────────
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ── サーバー設定 ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
